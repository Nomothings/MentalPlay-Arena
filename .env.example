# ================= MentalPlay-Arena configuration (template) =================
# Copy to .env and fill in real values. All settings load from .env.

# ----- LLM backend selection -----
# active backend: api | local | mock
LLM_ACTIVE_BACKEND=api

# ----- Primary cloud API (OpenAI-compatible) -----
LLM_API_BASE_URL=https://your-provider.example.com/openai/v1
LLM_API_KEY=
LLM_API_MODEL=your-model

# ----- Backup cloud API (optional) -----
LLM_BACKUP_BASE_URL=
LLM_BACKUP_KEY=
LLM_BACKUP_MODEL=

# ----- Local model via vllm (OpenAI-compatible) -----
LLM_LOCAL_BASE_URL=http://127.0.0.1:8001/v1
LLM_LOCAL_MODEL=Qwen2.5-0.5B-Instruct

# ----- Common LLM parameters -----
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_BATCH_SIZE=10
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# ----- Interview behavior -----
LLM_REFINE_QUESTIONS=true
LLM_EMPATHIC_RESPONSES=true
MAX_TURNS_PER_SCALE=1000

# ----- Patient memory -----
MEMORY_METHOD=none
MEMORY_WINDOW_SIZE=5

# ----- Storage (all relative to project root) -----
DATABASE_PATH=data/storage/arena.db
RUNS_DIR=data/runs
PREDICTIONS_DIR=data/predictions
CHARACTERS_PATH=data/characters.jsonl
GROUND_TRUTH_PATH=data/ground_truth/results.jsonl

# ----- Translation (Google Translate API; falls back to free endpoint) -----
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_SOURCE_LANG=zh-CN
TRANSLATION_TARGET_LANG=en

# ----- Model downloads -----
HF_ENDPOINT=https://hf-mirror.com

# Translation backend: llm | google_api | free
TRANSLATION_BACKEND=llm
